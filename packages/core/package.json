{
  "name": "@resumora/core",
  "version": "0.2.0",
  "description": "Recover users' unfinished work after crashes, refreshes and expired sessions, without treating stored data as authorization.",
  "keywords": [
    "continuity",
    "workflow-recovery",
    "crash-recovery",
    "offline",
    "checkpoint",
    "intent-journal",
    "multi-tenant",
    "local-first"
  ],
  "license": "Apache-2.0",
  "author": "Akshay Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshaykumar33/Resumora.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/akshaykumar33/Resumora/tree/main/packages/core#readme",
  "bugs": "https://github.com/akshaykumar33/Resumora/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
