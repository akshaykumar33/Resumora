{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Neon / Postgres connection string with embedded password",
            "_note": "Negative lookahead exempts ALL-CAPS placeholders (USER:PASSWORD@) so .env.example stays scannable without being a false positive. Real lowercase/mixed credentials still match.",
            "pattern": "/postgres(ql)?:\\/\\/(?![A-Z_]{2,}:[A-Z_]{2,}@)[^:\\s]+:[^@\\s]+@[^\\s\"']+/"
          },
          {
            "name": "GitHub token",
            "pattern": "/gh[pousr]_[A-Za-z0-9]{36,}/"
          },
          {
            "name": "Private key block",
            "pattern": "/-----BEGIN[ A-Z]*PRIVATE KEY-----/"
          },
          {
            "name": "Hardcoded JWT signing secret assignment",
            "pattern": "/JWT_SECRET\\s*[:=]\\s*[\"'](?!replace-me)[^\"'\\s]{12,}[\"']/"
          },
          {
            "name": "Signed JWT literal",
            "pattern": "/eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/"
          }
        ]
      }
    }
  ]
}
