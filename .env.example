# Resumora — environment template
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# Every value in THIS file must remain an obvious placeholder.
# See docs/security/PRE_COMMIT_VERIFICATION.md

# --- apps/api : authoritative backend ---

# Neon Postgres. Real value embeds a password — never commit it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# JWT signing secret for `jose`. Generate with: openssl rand -base64 32
# A leak here lets anyone mint a token for any tenant.
JWT_SECRET="replace-me-with-32-bytes-of-base64-randomness"

# Deliberately short, so the reference app can demonstrate expiry-driven recovery.
JWT_ACCESS_TTL="5m"
JWT_REFRESH_TTL="7d"

API_PORT="8787"

# --- apps/reference-app : demo client ---

VITE_API_URL="http://localhost:8787"

# Enables the Fault Lab control surface. Never enable in production.
VITE_ENABLE_FAULT_LAB="true"
