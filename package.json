{
  "name": "resumora-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Application Continuity & Workflow Recovery Runtime",
  "author": "Akshay Kumar <akshaykumarpatil33@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "check:paths": "node scripts/check-staged-paths.mjs",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "e2e": "playwright test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-pattern": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "secretlint": "^13.0.6",
    "tsup": "^8.5.1",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module"
}
